{
  "expo": {
    "name": "Tarabaho",
    "slug": "TarabahoMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TARABAHO.png",
    "scheme": "tarabahomobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "andrebacusmo",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tarabaho.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/TARABAHO.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/TARABAHO.png",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c040a070-1960-4b6a-b72f-91cd824b6a20"
      }
    }
  }
}
